# docker-mailserver environment configuration
# https://docker-mailserver.github.io/docker-mailserver/latest/config/environment/

# General
OVERRIDE_HOSTNAME=mail.hobbs.cz
LOG_LEVEL=info
SUPERVISOR_LOGLEVEL=warn
ONE_DIR=1
PERMIT_DOCKER=none

# Accounts
ACCOUNT_PROVISIONER=FILE
ENABLE_QUOTAS=0

# Networking
NETWORK_INTERFACE=venet0

# TLS
SSL_TYPE=letsencrypt
SSL_DOMAIN=imap.hobbs.cz

# Authentication
ENABLE_SASLAUTHD=0
ENABLE_LDAP=0
ENABLE_POSTGREY=0
ENABLE_CLAMAV=0
ENABLE_FAIL2BAN=0

# DKIM/DMARC/SPF
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0

# Spamassassin (disabled temporarily for debugging)
ENABLE_SPAMASSASSIN=0
SPAMASSASSIN_SPAM_TO_INBOX=1
MOVE_SPAM_TO_JUNK=1
SA_TAG=2.0
SA_TAG2=6.31
SA_KILL=10.0

# Postfix settings
POSTFIX_MESSAGE_SIZE_LIMIT=52428800
POSTMASTER_ADDRESS=postmaster@hobbs.cz

# Dovecot
DOVECOT_MAILBOX_FORMAT=maildir
ENABLE_IMAP=1
ENABLE_POP3=0
ENABLE_MANAGESIEVE=1

# Misc
ENABLE_UPDATE_CHECK=1
UPDATE_CHECK_INTERVAL=1d

# Relay
RELAY_HOST=
DEFAULT_RELAY_HOST=
