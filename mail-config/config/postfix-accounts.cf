# User accounts for docker-mailserver
# Format: user@domain|{SHA512-CRYPT}password_hash
#
# To add a new user, run:
#   docker exec -ti mailserver setup email add user@domain
#
# To change password:
#   docker exec -ti mailserver setup email update user@domain
#
# IMPORTANT: The passwords below are PLACEHOLDERS
# You must generate real passwords after deployment using the commands above
# or by running: docker run --rm -it ghcr.io/docker-mailserver/docker-mailserver setup email add user@domain

timothy@hobbs.cz|{SHA512-CRYPT}$6$PLACEHOLDER$REPLACE_ME_WITH_REAL_HASH
denisa@hobbs.cz|{SHA512-CRYPT}$6$PLACEHOLDER$REPLACE_ME_WITH_REAL_HASH
